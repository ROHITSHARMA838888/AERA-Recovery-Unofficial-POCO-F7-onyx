on property:post.decrypt.modules=true
    start onyx-wlan-prepare

on property:sys.aera.wlan.up=1 && property:sys.aera.onyx.wlan.ready=1
    setprop sys.aera.wlan.up 0
    mkdir /tmp/recovery 0755 root root
    mkdir /tmp/recovery/sockets 0770 wifi wifi
    start wpa_supplicant

service onyx-wlan-prepare /system/bin/sh /system/bin/onyx-wlan-prepare.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    disabled
    seclabel u:r:recovery:s0
